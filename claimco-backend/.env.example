# Use PostgreSQL locally and in production.
DATABASE_URL=
JWT_SECRET=change_me_to_a_long_random_string
PLATFORM_CUT_RATE=0.15
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://your-vercel-domain.vercel.app

# Optional: restrict signups to a campus email domain (e.g. "brown.edu").
# Leave blank during local dev/testing.
ALLOWED_EMAIL_DOMAIN=

# Optional Cloudinary upload configuration. If these are unset, the backend
# continues to accept existing base64 image data and stores it as a string.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Leave blank in dev — payments run in mock mode and are logged instead of
# hitting the real Stripe API. Set this once you have a Stripe test key.
STRIPE_SECRET_KEY=
STRIPE_REFRESH_URL=
STRIPE_RETURN_URL=

# Required when NODE_ENV=production.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

PORT=3001
